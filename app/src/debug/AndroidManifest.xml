<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only components. Never merged into a release build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Read-only probe: dumps how many rows each TvProvider listing table returns for this
            caller, and what the first rows look like. Start it explicitly:
                adb shell am start -n com.lakefront.tvlauncher/com.lakefront.tvlauncher.debug.TvListingsProbeActivity
            Read the result:
                adb shell logcat -d -s LakeTvProbe
        -->
        <activity
            android:name="com.lakefront.tvlauncher.debug.TvListingsProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true" />

        <!--
            Publishes a media session with rich metadata, so other launchers (Google TV's included)
            can be observed reacting to it:
                adb shell am start -n com.lakefront.tvlauncher/com.lakefront.tvlauncher.debug.FakeSessionActivity
        -->
        <activity
            android:name="com.lakefront.tvlauncher.debug.FakeSessionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Same, but as a service so the session survives (the activity above is destroyed at once). -->
        <service
            android:name="com.lakefront.tvlauncher.debug.FakeSessionService"
            android:exported="true" />
    </application>
</manifest>
